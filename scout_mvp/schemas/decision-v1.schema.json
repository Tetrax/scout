{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scout-mvp://schemas/decision-v1",
  "title": "Scout Decision V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "event_id", "model", "decision", "thematic_fit", "materiality", "attention", "reason_code", "factual_draft", "rationale", "source_urls", "factual_gate_id", "gate_action"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "event_id": {"type": "string", "minLength": 1},
    "model": {"const": "gpt-5.6-sol"},
    "decision": {"enum": ["SHOW", "KEEP_INTERNAL", "REJECT"]},
    "thematic_fit": {"enum": ["DIRECT", "ADJACENT", "WEAK"]},
    "materiality": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "attention": {"enum": ["NOW", "LATER", "NONE"]},
    "reason_code": {"type": "string", "minLength": 1, "pattern": "^[A-Z0-9]+(?:_[A-Z0-9]+)*$"},
    "factual_draft": {"type": "string", "maxLength": 2000},
    "rationale": {"type": "string", "maxLength": 2000},
    "source_urls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^https://[^\\s]+$"}
    },
    "factual_gate_id": {"type": "string", "minLength": 1},
    "gate_action": {"enum": ["MUST_SHOW", "ELIGIBLE"]}
  },
  "allOf": [
    {
      "if": {"properties": {"gate_action": {"const": "MUST_SHOW"}}},
      "then": {"properties": {"decision": {"const": "SHOW"}}}
    }
  ]
}
