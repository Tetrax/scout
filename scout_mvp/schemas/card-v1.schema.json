{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scout-mvp://schemas/card-v1",
  "title": "Scout Card V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "run_id", "profile_id", "event_id", "decision_id", "factual_gate_id", "rank", "category", "title", "what_changed", "why_for_me", "badges", "published_at", "source_links", "delivered_to", "delivered_at", "delivery_status"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "run_id": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "event_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "factual_gate_id": {"type": "string", "minLength": 1},
    "rank": {"type": "integer", "minimum": 1, "maximum": 3},
    "category": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "what_changed": {"type": "string", "minLength": 1, "maxLength": 4000},
    "why_for_me": {"type": "string", "minLength": 1, "maxLength": 2000},
    "badges": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "published_at": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "source_links": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "name", "url", "access"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://[^\\s]+$"},
          "access": {"enum": ["COLLECTED", "CITED_NOT_COLLECTED"]}
        }
      }
    },
    "delivered_to": {"const": "local"},
    "delivered_at": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "delivery_status": {"enum": ["PENDING", "DELIVERED", "FAILED"]}
  }
}
