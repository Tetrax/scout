{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scout-mvp://schemas/event-v1",
  "title": "Scout Event V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "observation_ids", "title", "summary", "canonical_url", "first_seen_at", "last_seen_at", "material_change", "provenance"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "event_type": {"enum": ["NEWS", "RELEASE", "SECURITY", "PROJECT", "ACTIVITY", "OTHER"]},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "canonical_url": {"type": "string", "pattern": "^https://[^\\s]+$"},
    "first_seen_at": {"type": "string", "minLength": 1},
    "last_seen_at": {"type": "string", "minLength": 1},
    "material_change": {"type": "boolean"},
    "material_change_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_urls", "observation_ids", "resolution"],
      "properties": {
        "source_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^https://[^\\s]+$"}
        },
        "observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "resolution": {"type": "string", "minLength": 1}
      }
    }
  }
}
