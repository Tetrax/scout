# Compose interpolation (non-secret example only)
SCOUT_IMAGE=scout:local
SCOUT_REVISION=development
SCOUT_PORT=13739
SCOUT_UID=1000
SCOUT_GID=1000
SCOUT_DATA_DIR=./runtime
SCOUT_ENV_FILE=.env.example

# Required application credentials. Replace outside Git.
SCOUT_USERNAME=replace-me
SCOUT_PASSWORD_HASH=replace-with-a-werkzeug-scrypt-derivative
SCOUT_SECRET_KEY=replace-with-at-least-32-random-bytes
